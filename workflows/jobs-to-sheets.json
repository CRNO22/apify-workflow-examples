      "waitBetweenTries": 2000
    },
    {
      "id": "prepare-sheet-rows",
      "name": "Prepare sheet rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "const rows=$input.all().flatMap(x=>Array.isArray(x.json)?x.json:[x.json]);\nconst seen=new Set();\nreturn rows.map(r=>{\n if(!r.runId||!r.id)throw new Error('Missing stable output identity.');\n const row={recordKey:[r.runId,r.source,r.id].join(':'),observedAt:r.observedAt,source:r.source,id:r.id,board:r.board,title:r.title,location:r.location,departments:(r.departments??[]).join('; '),changeType:r.changeType,changedFields:(r.changedFields??[]).join('; '),url:r.url,runId:r.runId};\n for(const k of Object.keys(row))if(row[k]===null||row[k]===undefined)row[k]='';\n return {json:row};\n}).filter(x=>{if(seen.has(x.json.recordKey))return false;seen.add(x.json.recordKey);return true;});",
        "mode": "runOnceForAllItems"
      }
    },
