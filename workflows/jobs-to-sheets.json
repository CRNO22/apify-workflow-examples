    {
      "id": "validate-settings",
      "name": "Validate settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const c=$input.first().json;\nif(!/^[a-zA-Z0-9_-]{20,}$/.test(c.spreadsheetId)||c.spreadsheetId.startsWith('REPLACE_'))throw new Error('Set your Google spreadsheet ID before starting a billed Actor run.');\nif(!c.sheetTab||!/^[a-zA-Z0-9][a-zA-Z0-9-]{1,60}$/.test(c.historyStoreName))throw new Error('Set the sheet tab and a valid history store name.');\nif(!Number.isInteger(c.maxItems)||c.maxItems<1||c.maxItems>1000)throw new Error('maxItems is outside the supported range.');\n\nif(typeof c.maxChargeUsd!=='number'||c.maxChargeUsd<c.maxItems*0.002||c.maxChargeUsd>10)throw new Error('Set maxChargeUsd between maxItems * $0.002 and $10.');\nif(!c.boardUrls?.trim())throw new Error('Set at least one supported job-board URL.');\n\nc.boards=[...new Set(c.boardUrls.split(/\\r?\\n/).map(x=>x.trim()).filter(Boolean).map(value=>{\n if(/^(greenhouse|lever|lever-eu|ashby):[A-Za-z0-9_-]+$/.test(value))return value;\n const match=/^https:\\/\\/(boards\\.greenhouse\\.io|job-boards\\.greenhouse\\.io|jobs\\.lever\\.co|jobs\\.eu\\.lever\\.co|jobs\\.ashbyhq\\.com)\\/([A-Za-z0-9_-]+)(?:\\/[A-Za-z0-9_-]+)*\\/?(?:[?#][^\\\\]*)?$/i.exec(value);\n if(!match||match[2]==='embed')throw new Error('Use a direct supported HTTPS board URL, such as https://job-boards.greenhouse.io/figma, or provider:slug.');\n const providers={'boards.greenhouse.io':'greenhouse','job-boards.greenhouse.io':'greenhouse','jobs.lever.co':'lever','jobs.eu.lever.co':'lever-eu','jobs.ashbyhq.com':'ashby'};\n return providers[match[1].toLowerCase()]+':'+match[2];\n}))];\nif(c.boards.length>20)throw new Error('Select at most 20 boards.');\n\nif(c.sendEmail&&(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(c.emailTo)||!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(c.emailFrom)))throw new Error('Set valid sender and recipient addresses before enabling email.');\nreturn [{json:c}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "start-actor",
      "name": "Start Actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "https://api.apify.com/v2/acts/cemented_jest~ats-jobs-change-monitor/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "method": "POST",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "waitForFinish",
              "value": "60"
            },
            {
              "name": "timeout",
              "value": "180"
            },
            {
              "name": "memory",
              "value": "256"
            },
            {
              "name": "maxTotalChargeUsd",
              "value": "={{ $json.maxChargeUsd }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({boards:$json.boards,keyword:$json.keyword,maxItems:$json.maxItems,trackChanges:true,historyStoreName:$json.historyStoreName,onlyChanges:true}) }}"
      }
    },
    {
      "id": "validate-run",
      "name": "Validate run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json.data;\nif(!r?.id||!r.status)throw new Error('Apify did not return a run.');\nif(['FAILED','ABORTED','TIMED-OUT'].includes(r.status))throw new Error('Actor '+r.status+'. Inspect https://console.apify.com/actors/runs/'+r.id);\nif(!['SUCCEEDED','READY','RUNNING','TIMING-OUT','ABORTING'].includes(r.status))throw new Error('Unexpected run status '+r.status);\nif(r.status!=='SUCCEEDED'&&Date.now()-Date.parse(r.startedAt)>360000)throw new Error('Run polling deadline exceeded. Inspect the existing run; do not start a duplicate.');\nreturn [{json:{run:r}}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "run-finished",
      "name": "Run finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "succeeded",
              "leftValue": "={{ $json.run.status }}",
              "rightValue": "SUCCEEDED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
