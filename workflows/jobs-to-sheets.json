      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const s=$input.first().json;\nif(s.status!=='succeeded')throw new Error('Run summary is '+s.status+'. Partial or budget-limited results were not written to Sheets. Inspect the existing run.');\nreturn [{json:{run:$('Validate run').first().json.run}}];",
        "mode": "runOnceForAllItems"
      }
    },
