          "handlingExtraData": "error"
        }
      }
    },
    {
      "id": "prepare-optional-alert",
      "name": "Prepare optional alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        0
      ],
      "parameters": {
        "jsCode": "const c=$('Settings').first().json;\nif(!c.sendEmail)return [];\nconst rows=$('Prepare sheet rows').all().map(x=>x.json).filter(r=>['new','changed'].includes(r.changeType));\nif(!rows.length)return [];\nconst clean=x=>String(x??'').replace(/[\\r\\n]+/g,' ').slice(0,250);\nconst lines=rows.slice(0,50).map(r=>[clean(r.changeType)+': '+clean(r.title)+' — '+clean(r.location),clean(r.url)].join('\\n'));\nreturn [{json:{subject:'Job monitor: '+rows.length+' new or changed postings',text:lines.join('\\n\\n')+'\\n\\nFull history: https://docs.google.com/spreadsheets/d/'+c.spreadsheetId+'\\nNew means first seen in this monitored selection; it does not prove the posting was just published.'}}];",
        "mode": "runOnceForAllItems"
      }
