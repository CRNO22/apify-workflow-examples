      "name": "Read saved dataset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "url": "=https://api.apify.com/v2/datasets/{{ $json.run.defaultDatasetId }}/items?format=json&clean=true&limit=1000",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "prepare-sheet-rows",
      "name": "Prepare sheet rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "const rows=$input.all().flatMap(x=>Array.isArray(x.json)?x.json:[x.json]);\nconst seen=new Set();\nreturn rows.map(r=>{\n if(!r.runId||!r.productId)throw new Error('Missing stable output identity.');\n const row={recordKey:[r.runId,r.categoryId,r.productId].join(':'),observedAt:r.scrapedAt,productId:r.productId,name:r.name,brand:r.brand,categoryId:r.categoryId,rank:r.rank,previousRank:r.previousRank,rankChange:r.rankChange,price:r.price,previousPrice:r.previousPrice,priceChange:r.priceChange,priceChangePercent:r.priceChangePercent,currency:r.currency,isSoldOut:r.isSoldOut,comparisonStatus:r.comparisonStatus,isNewEntry:r.isNewEntry,productUrl:r.productUrl,runId:r.runId};\n for(const k of Object.keys(row))if(row[k]===null||row[k]===undefined)row[k]='';\n return {json:row};\n}).filter(x=>{if(seen.has(x.json.recordKey))return false;seen.add(x.json.recordKey);return true;});",
        "mode": "runOnceForAllItems"
      }
    },
