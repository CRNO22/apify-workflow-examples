      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -130
      ],
      "parameters": {
        "content": "## Choose what to collect\nFill in Settings before running. Validation stops invalid inputs before starting a billed run.",
        "width": 660,
        "height": 520,
        "color": 7
      }
    },
