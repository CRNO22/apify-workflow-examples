        0
      ],
      "parameters": {
        "url": "=https://api.apify.com/v2/key-value-stores/{{ $json.run.defaultKeyValueStoreId }}/records/SUMMARY",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "responseFormat": "json"
