      }
    },
    {
      "id": "settings",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "spreadsheetId",
              "name": "spreadsheetId",
              "value": "REPLACE_WITH_YOUR_SPREADSHEET_ID",
              "type": "string"
            },
            {
              "id": "sheetTab",
              "name": "sheetTab",
              "value": "OliveYoungHistory",
              "type": "string"
            },
            {
              "id": "historyStoreName",
              "name": "historyStoreName",
              "value": "n8n-oliveyoung-history-v1",
              "type": "string"
            },
            {
              "id": "maxItems",
              "name": "maxItems",
              "value": 100,
              "type": "number"
            },
            {
              "id": "maxChargeUsd",
              "name": "maxChargeUsd",
              "value": 0.25,
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "validate-settings",
      "name": "Validate settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const c=$input.first().json;\nif(!/^[a-zA-Z0-9_-]{20,}$/.test(c.spreadsheetId)||c.spreadsheetId.startsWith('REPLACE_'))throw new Error('Set your Google spreadsheet ID before starting a billed Actor run.');\nif(!c.sheetTab||!/^[a-zA-Z0-9][a-zA-Z0-9-]{1,60}$/.test(c.historyStoreName))throw new Error('Set the sheet tab and a valid history store name.');\nif(!Number.isInteger(c.maxItems)||c.maxItems<1||c.maxItems>100)throw new Error('maxItems is outside the supported range.');\nif(c.maxItems!==100)throw new Error('This comparison workflow requires maxItems=100 to collect the complete ranking and save its baseline.');\nif(typeof c.maxChargeUsd!=='number'||c.maxChargeUsd<c.maxItems*0.002||c.maxChargeUsd>10)throw new Error('Set maxChargeUsd between maxItems * $0.002 and $10.');\n\nreturn [{json:c}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "start-actor",
      "name": "Start Actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "https://api.apify.com/v2/acts/cemented_jest~oliveyoung-global-bestsellers/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "method": "POST",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "waitForFinish",
              "value": "60"
            },
            {
              "name": "timeout",
              "value": "180"
            },
            {
              "name": "memory",
              "value": "256"
            },
            {
              "name": "maxTotalChargeUsd",
              "value": "={{ $json.maxChargeUsd }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({categoryIds:[\"all\"],maxItemsPerCategory:$json.maxItems,trackChanges:true,historyStoreName:$json.historyStoreName,proxyConfiguration:{useApifyProxy:false}}) }}"
      }
    },
    {
      "id": "validate-run",
      "name": "Validate run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json.data;\nif(!r?.id||!r.status)throw new Error('Apify did not return a run.');\nif(['FAILED','ABORTED','TIMED-OUT'].includes(r.status))throw new Error('Actor '+r.status+'. Inspect https://console.apify.com/actors/runs/'+r.id);\nif(!['SUCCEEDED','READY','RUNNING','TIMING-OUT','ABORTING'].includes(r.status))throw new Error('Unexpected run status '+r.status);\nif(r.status!=='SUCCEEDED'&&Date.now()-Date.parse(r.startedAt)>360000)throw new Error('Run polling deadline exceeded. Inspect the existing run; do not start a duplicate.');\nreturn [{json:{run:r}}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "run-finished",
      "name": "Run finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "succeeded",
              "leftValue": "={{ $json.run.status }}",
              "rightValue": "SUCCEEDED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "wait",
      "name": "Wait 10 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        250
      ],
      "parameters": {
        "amount": 10,
        "unit": "seconds"
